# -------------------------------------------------------------
# AI Image & Video Studio - Environment Configuration
# -------------------------------------------------------------

# Port & Server Configuration
PORT=3000
NODE_ENV=development
BACKEND_PUBLIC_URL=http://localhost:3000

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=your_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1

# Primary Database (MySQL)
DATABASE_URL="mysql://studio_user:studio_password@localhost:3306/ai_studio"

# Redis Cache and BullMQ Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets
JWT_SECRET=studio-super-secret-jwt-key-32chars
JWT_REFRESH_SECRET=studio-super-secret-refresh-key-32

# AWS S3-compatible Object Storage (Optional: Local disk storage used by default)
S3_BUCKET=studio-media
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/studio-media

# Local Upload Directory Fallback
UPLOAD_DIR=./uploads
